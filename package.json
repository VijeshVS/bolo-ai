{
  "name": "bolo-ai",
  "version": "1.0.0",
  "description": "macOS voice to structured text desktop app",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && cross-env NODE_ENV=development electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --mac",
    "pack": "npm run build && electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google-cloud/speech": "^5.6.0",
    "@google/generative-ai": "^0.16.1",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "openai": "^6.32.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
